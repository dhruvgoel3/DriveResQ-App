rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null &&
        (exists(/databases/$(database)/documents/admin/$(request.auth.uid)) ||
         exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)));
    }

    // ─── USERS ───
    // Authenticated users can read profiles for chats, names, and mechanic listings
    // Only the profile owner or admin can modify their document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // ResQ Assistant private chat history inside user profile
      match /resq_chats/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Emergency contacts subcollection inside user profile
      match /emergency_contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── REQUESTS (ROADSIDE ASSISTANCE) ───
    // Drivers create requests; drivers and mechanics can read/update active status
    match /requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // ─── COMPLETED JOBS ───
    match /completedJobs/{jobId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // ─── CHATS & MESSAGES ───
    match /chats/{chatId} {
      allow create, read, update: if request.auth != null;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow create, read, update: if request.auth != null;
        allow delete: if isAdmin();
      }
    }

    // ─── NOTIFICATIONS ───
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ─── ADMIN ONLY COLLECTIONS (Secured with isAdmin) ───
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
    match /adminUsers/{document=**} {
      allow read, write: if isAdmin();
    }
    match /adminSettings/{document=**} {
      allow read, write: if isAdmin();
    }
    match /adminActions/{document=**} {
      allow read, write: if isAdmin();
    }
    match /mail/{document=**} {
      allow create, read, write: if request.auth != null;
    }

    // ─── MECHANIC APPLICATIONS / ONBOARDING ───
    match /mechanic_applications/{docId} {
      allow create, read: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == docId || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── MECHANIC LIVE LOCATIONS ───
    // Mechanics update their location; authenticated users can read for live tracking
    match /mechanic_locations/{mechanicId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == mechanicId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == mechanicId || isAdmin());
    }

    // ─── SAFETY SOS — EMERGENCY CONTACTS ───
    // Each driver can only access their own emergency contacts.
    match /emergency_contacts/{driverId} {
      allow read, write: if request.auth != null && request.auth.uid == driverId;

      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == driverId;
      }
    }

    // ─── SAFETY SOS — INCIDENTS ───
    // Drivers can create incidents and update their own live location.
    // Emergency contacts receiving the live tracking link on WhatsApp can read in real-time.
    // Admins can manage all incidents.
    match /sos_incidents/{incidentId} {
      allow create: if request.auth != null
                    && request.resource.data.driverId == request.auth.uid;
      allow read: if resource.data.isLiveTrackingActive == true
                  || resource.data.status in ['sent', 'active', 'resolved']
                  || (request.auth != null && (resource.data.driverId == request.auth.uid || isAdmin()));
      allow update: if request.auth != null
                    && resource.data.driverId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── PRICING CONFIGURATION (DYNAMIC TRAVEL FEES) ───
    // Authenticated users can read pricing rules; only admins can adjust rates
    match /pricing_config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
