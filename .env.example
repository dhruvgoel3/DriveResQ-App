# Copy this file to `.env` and fill in real values from the Firebase console
# (Project settings > General > Your apps). `.env` is gitignored and must
# never be committed.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key
FIREBASE_IOS_API_KEY=your_firebase_ios_api_key
FIREBASE_WINDOWS_API_KEY=your_firebase_windows_api_key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESQ_ASSISTANT_API_URL=https://us-central1-driveresq-app.cloudfunctions.net/askResQAssistant
